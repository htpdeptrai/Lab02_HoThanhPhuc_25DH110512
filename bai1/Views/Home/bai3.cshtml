@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Bai 3</title>
    <style>
        .recipe {
            width: 850px;
            margin: 30px auto;
            background-color: #e60000;
            color: white;
            border: 4px solid white;
            font-family: Arial, sans-serif;
        }

            .recipe table {
                width: 100%;
                border-collapse: collapse;
            }

            .recipe th {
                text-align: left;
                padding: 12px;
                font-size: 18px;
                border-bottom: 1px solid #ff6666;
            }

            .recipe td {
                padding: 8px 12px;
                border-bottom: 1px solid #ff6666;
            }

            .recipe tr:nth-child(even) td {
                background-color: #f04444;
            }

            .recipe tr:nth-child(odd) td {
                background-color: #e60000;
            }

        .col1 {
            width: 55%;
        }

        .col2,
        .col3 {
            width: 22.5%;
        }

        .note {
            padding: 8px 12px;
            border-bottom: 1px solid #ff6666;
        }

        .instructions {
            padding: 10px 15px 20px;
        }

            .instructions ol {
                margin-top: 5px;
                padding-left: 25px;
            }

            .instructions li {
                margin-bottom: 8px;
                line-height: 1.3;
            }
    </style>
</head>
<body>
    <div class="recipe">

        <table>
            <tr>
                <th class="col1">Ingredients</th>
                <th class="col2">serves 12</th>
                <th class="col3">serves 24</th>
            </tr>

            <tr>
                <td>milk</td>
                <td>1 quart</td>
                <td>2 quart</td>
            </tr>

            <tr>
                <td>cinnamon sticks</td>
                <td>2</td>
                <td>1</td>
            </tr>

            <tr>
                <td>vanilla bean, split</td>
                <td>1</td>
                <td>2</td>
            </tr>

            <tr>
                <td>cloves</td>
                <td>5</td>
                <td>10</td>
            </tr>

            <tr>
                <td>mace</td>
                <td>10 blades</td>
                <td>20 blades</td>
            </tr>

            <tr>
                <td>egg yolks</td>
                <td>12</td>
                <td>24</td>
            </tr>

            <tr>
                <td>cups sugar</td>
                <td>1 1/2 cups</td>
                <td>3 cups</td>
            </tr>

            <tr>
                <td>dark rum</td>
                <td>1 1/2 cups</td>
                <td>3 cups</td>
            </tr>

            <tr>
                <td>brandy</td>
                <td>1 1/2 cups</td>
                <td>3 cups</td>
            </tr>

            <tr>
                <td>vanilla</td>
                <td>1 tbsp</td>
                <td>2 tbsp</td>
            </tr>

            <tr>
                <td>half-and-half or light cream</td>
                <td>1 quart</td>
                <td>2 quart</td>
            </tr>
        </table>

        <div class="note">
            Freshly grated nutmeg to taste.
        </div>

        <div class="instructions">
            <ol>
                <li>Instruction 1 from the handout</li>
                <li>Instruction 2 from the handout</li>
                <li>Instruction 3 from the handout</li>
                <li>Instruction 4 from the handout</li>
            </ol>
        </div>

    </div>
</body>
</html>
