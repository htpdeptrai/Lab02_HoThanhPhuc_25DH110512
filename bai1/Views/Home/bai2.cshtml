@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Bai 2</title>
    <style>
        .table2 {
            width: 800px;
            border-collapse: collapse;
            font-family: Arial, sans-serif;
            font-size: 14px;
            color: #666;
        }

            .table2 th {
                background-color: #eeeeee;
                border: 1px solid #d5d5d5;
                padding: 10px;
                text-align: left;
                font-weight: normal;
            }

            .table2 td {
                border: 1px solid #dddddd;
                padding: 8px;
                background-color: #fafafa;
            }

            .table2 .topic {
                width: 55%;
            }

            .table2 .number {
                width: 8%;
                text-align: center;
            }

            .table2 .lastpost {
                width: 20%;
            }

        .topic-title {
            color: #7fa6c1;
            font-size: 18px;
        }

        .description {
            color: #999;
            font-size: 11px;
            margin-left: 25px;
            margin-top: 3px;
        }

        .lastpost-text {
            color: #999;
            font-size: 11px;
        }
    </style>
</head>
<body>
    <table class="table2">

        <tr>
            <th class="topic">Topic</th>
            <th class="number">Posts</th>
            <th class="number">Views</th>
            <th class="lastpost">Last Post</th>
        </tr>

        <tr>
            <td>
                🔒 <span class="topic-title">Posting Guidelines</span>
                <div class="description">
                    Posted in Please Read First! by Joe Gillespie
                </div>
